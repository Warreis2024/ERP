{
  "name": "yontem-erp",
  "version": "0.1.0",
  "private": true,
  "description": "Yöntem ERP — durum tabanlı, fonksiyonlarla kurulan modüler ERP (sunucu + API)",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "migrate": "knex --knexfile knexfile.js migrate:latest",
    "migrate:geri": "knex --knexfile knexfile.js migrate:rollback",
    "seed": "knex --knexfile knexfile.js seed:run",
    "admin": "node scripts/admin-olustur.js",
    "test": "node --test"
  },
  "dependencies": {
    "argon2": "^0.41.1",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "helmet": "^8.0.0",
    "knex": "^3.1.0",
    "pg": "^8.13.1",
    "tedious": "^18.6.1",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  }
}
