# ---- Çalışma modu ----
# tek   : tek firma (test: Vercel + Supabase). FIRMA_SUB ve DATABASE_URL kullanılır.
# coklu : firma başına ayrı veritabanı (canlı: IIS + MS SQL). Firma, alt alan adından katalogda bulunur.
MOD=tek
FIRMA_SUB=yontem
FIRMA_AD=Yöntem Teknoloji
ANA_ALAN=iq-sense.com.tr

# ---- Veritabanı (MOD=tek) ----
# pg    : PostgreSQL / Supabase  → postgresql://kullanici:sifre@host:5432/postgres
# mssql : MS SQL Server          → mssql://kullanici:sifre@sunucu:1433/yerp_yontem?encrypt=true&trustServerCertificate=true
DB_CLIENT=pg
DATABASE_URL=postgresql://postgres:SIFRE@db.PROJE.supabase.co:5432/postgres
# Supabase'de bağlantı havuzu (pooler) önerilir, Vercel'de sunucusuz fonksiyonlar çok bağlantı açar:
# DATABASE_URL=postgresql://postgres.PROJE:SIFRE@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DB_HAVUZ_MAX=5

# ---- Katalog (MOD=coklu) ----
# Firmaların listesi ve hangi veritabanına bağlanacakları bu veritabanında durur.
# KATALOG_DB_CLIENT=mssql
# KATALOG_DATABASE_URL=mssql://erp:SIFRE@localhost:1433/yerp_katalog?trustServerCertificate=true
# Katalogdaki "db_env" alanı, firmanın bağlantı adresinin bulunduğu ortam değişkeninin adıdır (şifre veritabanında tutulmaz):
# DB_YONTEM=mssql://erp:SIFRE@localhost:1433/yerp_yontem?trustServerCertificate=true

# ---- Güvenlik ----
# En az 32 karakter rastgele değer: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
OTURUM_GIZLI=DEGISTIR_BUNU_EN_AZ_32_KARAKTER
# Oturum süresi (saat). "Beni hatırla" işaretliyse HATIRLA_GUN geçerlidir.
OTURUM_SAAT=12
HATIRLA_GUN=30
# Üretimde true: çerezler yalnız HTTPS ile gider.
GUVENLI_CEREZ=true

# ---- Dosya deposu ----
# disk     : sunucu diski / NAS paylaşımı (IIS)  → DEPO_KLASOR
# supabase : Supabase Storage (Vercel)          → SUPABASE_URL, SUPABASE_SERVICE_KEY, SUPABASE_BUCKET
DEPO=supabase
DEPO_KLASOR=./yuklemeler
SUPABASE_URL=https://PROJE.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=erp-dosyalar

# ---- İlk yönetici (npm run admin) ----
ADMIN_EPOSTA=admin@iq-sense.com.tr
ADMIN_SIFRE=admin123

PORT=3000
